{
  "name": "dsh-price-peak",
  "version": "0.1.2",
  "description": "DeepSeek peak/off-peak price multiplier in the composer dock: Beijing-time schedule, live-refreshed from the official pricing page.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "pricing"
  ],
  "license": "MIT",
  "author": "pokmandeng",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "lib/",
    "src/",
    "build.mjs",
    "preview.mjs",
    "preview-ui.mjs",
    "README.md",
    "README.en.md",
    "install.md",
    "install/",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "check:build": "node build.mjs --check",
    "test": "node --test test/core.test.mjs test/parse.test.mjs test/host.test.mjs test/client-bundle.test.mjs",
    "preview": "node preview.mjs",
    "preview:ui": "node preview-ui.mjs --open",
    "verify": "npm run check:build && npm test",
    "probe:setup": "ln -sfn \"$HOME/.dsh/profiles/node_modules\" node_modules"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noob-in-training/dsh-price-peak.git"
  },
  "homepage": "https://github.com/Noob-in-training/dsh-price-peak#readme",
  "bugs": {
    "url": "https://github.com/Noob-in-training/dsh-price-peak/issues"
  }
}
